		<!-- Release 1.25.1 supports RTC6 PCIe and RTC6 Ethernet hardware revision 1.
		     Note that the bitstream content was renamed to RTC6RBF_CEBA4.rbf in this release.

		     Linux note: this source only extracts the Windows SDK binary, but the driver
		     resolves the rtc6dllx64 resource and dlopen()s it on non-Windows builds
		     (see Implementation/libmcdriver_scanlab_sdk.cpp). On Linux the SDK shared
		     library librtc6.so, shipped in this release as
		     RTC6 Files/Linux/debian-bookworm/rtc6-devel_0.1.55-1_amd64.deb, must therefore
		     be provided under the same rtc6dllx64 resource name. That .deb is not declared
		     as a source entry here: add one with its url and sha256, or place librtc6.so
		     under that resource name manually before using the driver on Linux. -->
		<content filename="RTC6-1.25.1/RTC6 Files/Windows/RTC6DLLx64.dll" resourcename="rtc6dllx64" />
		<content filename="RTC6-1.25.1/RTC6 Files/Program Files/RTC6DAT.dat" resourcename="rtc6dat" />
		<content filename="RTC6-1.25.1/RTC6 Files/Program Files/RTC6ETH.out" resourcename="rtc6eth" />
		<content filename="RTC6-1.25.1/RTC6 Files/Program Files/RTC6RBF_CEBA4.rbf" resourcename="rtc6rbf" />
		<content filename="RTC6-1.25.1/RTC6 Files/Program Files/RTC6OUT.out" resourcename="rtc6out" />
		
