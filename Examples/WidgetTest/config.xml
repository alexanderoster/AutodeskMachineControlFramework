<?xml version="1.0" encoding="UTF-8"?>
<machinedefinition xmlns="http://schemas.autodesk.com/amc/machinedefinitions/2020/02" xmlns:sync="http://schemas.autodesk.com/amc/synchronization/2020/02" xmlns:i18n="http://schemas.autodesk.com/amc/internationalization/2023/08" xmlns:format="http://schemas.autodesk.com/amc/format/2023/08" client="svelte">
	<services threadcount="32"/>

	<internationalization default="en">
		<language identifier="en" name="English" resource="language_english" />
	</internationalization>

	<accesscontrol>
		<defaultusers>
			<defaultuser name="test" salt="f735faa2ac49ac0a68dbf41d9cd57cfb426ef91eb19726afd8f075ac625cccb2" passwordhash="556080937385d8eb21ea0e8707d7cf3e94b79ed234596ba8a2ac98da1ff4fee3" description="Widget test user" />
		</defaultusers>

		<permissions>
			<permission identifier="permission_view_builds" displayname="View Builds" description="Can view build files." />
			<permission identifier="permission_acknowledgealerts" displayname="Acknowledge Alerts" description="Can acknowledge alerts." />
		</permissions>

		<roles default="administrator">
			<role identifier="administrator" displayname="Administrator" description="Full access">
				<permission identifier="permission_view_builds" />
				<permission identifier="permission_acknowledgealerts" />
			</role>
		</roles>
	</accesscontrol>

	<alerts>
		<alert identifier="alert_info"     level="message"       description="Informational test alert - all systems nominal." />
		<alert identifier="alert_warning"  level="warning"       description="Warning test alert - temperature approaching threshold." acknowledgepermission="permission_acknowledgealerts" />
		<alert identifier="alert_error"    level="criticalerror" description="Error test alert - sensor communication lost." acknowledgepermission="permission_acknowledgealerts" />
		<alert identifier="alert_critical" level="fatalerror"    description="Critical test alert - emergency stop activated." acknowledgepermission="permission_acknowledgealerts" />
	</alerts>

	<!-- ================================================================================================ -->
	<!-- Main state machine                                                                                -->
	<!-- ================================================================================================ -->

	<statemachine name="main" description="Widget Test System" initstate="init" failedstate="fatalerror" library="plugin_main">

		<parametergroup name="sensors" description="Sensor Readings">
			<parameter name="temperature"    description="Chamber Temperature (C)"  default="22.5"    type="double"/>
			<parameter name="pressure"       description="Chamber Pressure (hPa)"   default="1013.25" type="double"/>
			<parameter name="humidity"       description="Relative Humidity (%)"    default="45.0"    type="double"/>
			<parameter name="laser_power"    description="Laser Power (W)"          default="0.0"     type="double"/>
			<parameter name="gas_flow"       description="Gas Flow Rate (l/min)"    default="0.0"     type="double"/>
			<parameter name="build_progress" description="Build Progress (%)"       default="0.0"     type="double"/>
		</parametergroup>

		<parametergroup name="counters" description="System Counters">
			<parameter name="cycle_count"   description="State Machine Cycles"  default="0"   type="int"/>
			<parameter name="layer_current" description="Current Layer"         default="0"   type="int"/>
			<parameter name="layer_total"   description="Total Layers"          default="250" type="int"/>
			<parameter name="error_count"   description="Error Count"           default="0"   type="int"/>
			<parameter name="warning_count" description="Warning Count"         default="0"   type="int"/>
		</parametergroup>

		<parametergroup name="display" description="Display Values">
			<parameter name="machine_state"  description="Current Machine State"  default="Initializing" type="string"/>
			<parameter name="status_message" description="Status Message"         default="Starting up" type="string"/>
			<parameter name="last_event"     description="Last UI Event"          default="none" type="string"/>
			<parameter name="formatted_time" description="Uptime"                 default="00:00:00" type="string"/>
		</parametergroup>

		<parametergroup name="flags" description="System Flags">
			<parameter name="is_running"  description="Process Running"  default="0" type="bool"/>
			<parameter name="is_paused"   description="Process Paused"   default="0" type="bool"/>
			<parameter name="heater_on"   description="Heater Active"    default="0" type="bool"/>
			<parameter name="gas_flowing" description="Gas Flow Active"  default="0" type="bool"/>
			<parameter name="door_locked" description="Door Locked"      default="1" type="bool"/>
		</parametergroup>

		<signaldefinition name="signal_start">
		</signaldefinition>

		<signaldefinition name="signal_stop">
		</signaldefinition>

		<signaldefinition name="signal_pause">
		</signaldefinition>

		<signaldefinition name="signal_resume">
		</signaldefinition>

		<signaldefinition name="signal_toggleheater">
		</signaldefinition>

		<signaldefinition name="signal_togglegasflow">
		</signaldefinition>

		<signaldefinition name="signal_resetcounters">
		</signaldefinition>

		<state name="init" repeatdelay="10">
			<outstate target="idle"/>
		</state>

		<state name="idle" repeatdelay="500">
			<outstate target="idle"/>
			<outstate target="running"/>
		</state>

		<state name="running" repeatdelay="200">
			<outstate target="running"/>
			<outstate target="idle"/>
			<outstate target="paused"/>
		</state>

		<state name="paused" repeatdelay="500">
			<outstate target="running"/>
			<outstate target="idle"/>
			<outstate target="paused"/>
		</state>

		<state name="fatalerror" repeatdelay="5000">
			<outstate target="init"/>
		</state>

	</statemachine>


	<!-- ================================================================================================ -->
	<!-- User Interface                                                                                    -->
	<!-- ================================================================================================ -->

	<userinterface appname="AMCF Widget Test" copyright="2026 Autodesk Inc." mainpage="dashboard" library="plugin_userinterface">

		<logo resource="ui_logo" aspectratio="3.0"/>

		<login
			backgroundresource="login_background"
			loginstyle="classic"
			loginsubtitle="Widget Test Environment"
			welcomemessage="Widget Test Suite - verifying all AMCF UI components end to end."
		/>

		<colors>
			<color name="primary" red="0.784" green="0.063" blue="0.180"/>
			<color name="secondary" red="0.235" green="0.235" blue="0.235"/>
			<color name="accent" red="0.784" green="0.063" blue="0.180"/>
			<color name="error" red="0.867" green="0.133" blue="0.133"/>
		</colors>

		<!-- Per-client-session variables. Every browser session has its own copy.
		     Inputs of the UI formula demonstrator (page "formulademo"), written by the
		     onformulademochange event and reset to these defaults by onformulademoreset. -->
		<sessionvariables>
			<parameter name="formula_a" type="double" default="12.5" description="Formula demonstrator: number A"/>
			<parameter name="formula_b" type="double" default="4" description="Formula demonstrator: number B"/>
			<parameter name="formula_level" type="double" default="75" description="Formula demonstrator: level slider in percent"/>
			<parameter name="formula_text" type="string" default="WidgetTest" description="Formula demonstrator: free text"/>
			<parameter name="formula_flag" type="bool" default="1" description="Formula demonstrator: flag switch"/>
			<parameter name="formula_unit" type="string" default="mm" description="Formula demonstrator: selected length unit"/>
		</sessionvariables>

		<!-- ================================ DIALOGS ================================ -->

		<dialog name="testdialog">
			<content name="dlgcontent" title="Test Dialog">

				<statusbanner name="dlg_banner" severity="warning" title="Dialog Test" description="This is a modal dialog with a status banner, separator, and action buttons."/>

				<separator name="dlg_sep1" orientation="horizontal" variant="light"/>

				<paragraph text="Confirm or dismiss this dialog to test event handling." variant="subtext"/>

				<separator name="dlg_sep2" orientation="horizontal" variant="light"/>

				<buttongroup distribution="equal">
					<button caption="Confirm" event="dismissdialog"/>
					<button caption="Dismiss" event="dismissdialog"/>
				</buttongroup>

			</content>
		</dialog>


		<!-- ================================================================== -->
		<!-- PAGE 1: Dashboard                                                   -->
		<!-- Tests: paragraph, statusbanner, separator, form, image, grid        -->
		<!-- ================================================================== -->

		<page name="dashboard">
			<grid name="dashgrid">
				<column width="5" unit="free"/>
				<column width="3" unit="free"/>

				<row height="1" unit="free"/>
				<row height="100" unit="pt"/>

				<content name="overview" cardstyle="elevated" title="System Overview" columnstart="1" rowstart="1" columnend="1" rowend="1">

					<statusbanner name="dash_status" severity="ok" title="System Ready" description="All subsystems operational. Widget test environment is running."/>

					<separator name="sep_dash_1" orientation="horizontal" variant="light"/>

					<paragraph text="Machine State" variant="h2"/>

					<form name="stateform">
						<edit name="f_state"   caption="State"          sync:value="main.$state" readonly="1"/>
						<edit name="f_status"  caption="Status"         sync:value="main.display.status_message" readonly="1"/>
						<edit name="f_uptime"  caption="Uptime"         sync:value="main.display.formatted_time" readonly="1"/>
						<edit name="f_cycles"  caption="Cycle Count"    sync:value="main.counters.cycle_count" readonly="1"/>
					</form>

					<separator name="sep_dash_2" orientation="horizontal" variant="light"/>

					<paragraph text="Sensor Readings" variant="h2"/>

					<form name="sensorform">
						<edit name="f_temp"     caption="Temperature (C)"  sync:value="main.sensors.temperature" readonly="1"/>
						<edit name="f_pressure" caption="Pressure (hPa)"   sync:value="main.sensors.pressure" readonly="1"/>
						<edit name="f_humidity" caption="Humidity (%)"      sync:value="main.sensors.humidity" readonly="1"/>
						<edit name="f_laser"    caption="Laser Power (W)"   sync:value="main.sensors.laser_power" readonly="1"/>
						<edit name="f_gas"      caption="Gas Flow (l/min)"  sync:value="main.sensors.gas_flow" readonly="1"/>
					</form>

				</content>

				<content name="machineimg" title="Machine View" columnstart="2" rowstart="1" columnend="2" rowend="1">
					<image resource="ui_logo" aspectratio="2" maxheight="80"/>

					<separator name="sep_dash_3" orientation="horizontal" variant="light"/>

					<paragraph text="Quick Controls" variant="h2"/>

					<form name="controlform">
						<switch name="sw_heater"  caption="Heater" sync:value="main.flags.heater_on" changeevent="toggleheater"/>
						<switch name="sw_gasflow" caption="Gas Flow" sync:value="main.flags.gas_flowing" changeevent="togglegasflow"/>
					</form>

					<separator name="sep_dash_4" orientation="horizontal" variant="light"/>

					<paragraph text="Process Control" variant="h2"/>

					<buttongroup distribution="equal">
						<button caption="Start Process" event="startprocess"/>
						<button caption="Stop Process" event="stopprocess"/>
					</buttongroup>

					<buttongroup distribution="equal">
						<button caption="Pause" event="pauseprocess"/>
						<button caption="Resume" event="resumeprocess"/>
					</buttongroup>

				</content>

				<content name="dashquick" columnstart="1" rowstart="2" columnend="2" rowend="2" rowposition="centered">
					<buttongroup distribution="equal">
						<button caption="Reset Counters" event="resetcounters"/>
						<button caption="Create Alert" event="createtestalert"/>
						<button caption="Generate Logs" event="generatelogmessages"/>
						<button caption="Update Chart" event="updatechartdata"/>
					</buttongroup>
				</content>
			</grid>
		</page>


		<!-- ================================================================== -->
		<!-- PAGE 2: Typography &amp; Layout                                     -->
		<!-- Tests: paragraph (all variants), separator (h/v, light/dark)        -->
		<!-- ================================================================== -->

		<page name="typography">
			<content name="typopanel" cardstyle="elevated" title="Typography &amp; Separators" scrollbars="1">

				<paragraph text="Heading 1 - Main Title" variant="h1"/>
				<paragraph text="Heading 2 - Section Title" variant="h2"/>
				<paragraph text="Heading 3 - Subsection" variant="h3"/>

				<separator name="sep_typo_1" orientation="horizontal" variant="light"/>

				<paragraph text="Body Text - This is standard body paragraph text used for descriptions and content areas. It should be legible at normal reading distance with proper line height and spacing." variant="body"/>

				<separator name="sep_typo_2" orientation="horizontal" variant="dark"/>

				<paragraph text="Subtext - Used for secondary information, captions, and helper text." variant="subtext"/>

				<separator name="sep_typo_3" orientation="horizontal" variant="light"/>

				<paragraph text="Label - FIELD LABEL STYLE" variant="label"/>

				<separator name="sep_typo_4" orientation="horizontal" variant="dark"/>

				<paragraph text="This section verifies that all paragraph variants render correctly: h1, h2, h3, body, subtext, and label." variant="body"/>

			</content>
		</page>


		<!-- ================================================================== -->
		<!-- PAGE 3: Form Fields                                                 -->
		<!-- Tests: form with edit, switch, memo, combobox, number, slider       -->
		<!-- ================================================================== -->

		<page name="forms">
			<grid name="formsgrid">
				<column width="1" unit="free"/>
				<column width="1" unit="free"/>

				<row height="1" unit="free"/>

				<content name="formpanel1" cardstyle="elevated" title="Input Fields" columnstart="1" rowstart="1" columnend="1" rowend="1" scrollbars="1">

					<paragraph text="Text &amp; Numeric Inputs" variant="h2"/>

					<form name="testform1" changeevent="formchanged">
						<edit name="tf_text" caption="Text Input" value="Sample text"/>
						<edit name="tf_readonly" caption="Read-Only Field" value="Cannot edit" readonly="1"/>
						<edit name="tf_synced" caption="Synced Field" sync:value="main.display.machine_state" readonly="1"/>

						<separator name="sep_form_1" orientation="horizontal" variant="light"/>

						<memo name="tf_memo" caption="Multi-line Memo" value="Line 1&#10;Line 2&#10;Line 3"/>

						<separator name="sep_form_2" orientation="horizontal" variant="light"/>

						<combobox name="tf_combo" caption="Dropdown Select" value="1">
							<item text="Option A" value="0"/>
							<item text="Option B" value="1"/>
							<item text="Option C" value="2"/>
							<item text="Option D" value="3"/>
						</combobox>
					</form>

				</content>

				<content name="formpanel2" cardstyle="elevated" title="Toggle &amp; Range Fields" columnstart="2" rowstart="1" columnend="2" rowend="1" scrollbars="1">

					<paragraph text="Switches &amp; Sliders" variant="h2"/>

					<form name="testform2" changeevent="formchanged">
						<switch name="tf_switch1" caption="Enable Feature A" value="1"/>
						<switch name="tf_switch2" caption="Enable Feature B" value="0"/>
						<switch name="tf_syncsw" caption="Heater Status" sync:value="main.flags.heater_on" changeevent="toggleheater"/>

						<separator name="sep_form_3" orientation="horizontal" variant="light"/>

						<edit name="tf_number" caption="Layer Count" value="250"/>

						<separator name="sep_form_4" orientation="horizontal" variant="light"/>

						<paragraph text="Synced Values" variant="h2"/>

						<edit name="tf_temp"     caption="Temperature"  sync:value="main.sensors.temperature" readonly="1"/>
						<edit name="tf_pressure" caption="Pressure"     sync:value="main.sensors.pressure" readonly="1"/>
						<edit name="tf_progress" caption="Progress (%)" sync:value="main.sensors.build_progress" readonly="1"/>
					</form>

				</content>
			</grid>
		</page>


		<!-- ================================================================== -->
		<!-- PAGE 4: Buttons &amp; Actions                                       -->
		<!-- Tests: buttongroup (distributions), button (events, sync:disabled)  -->
		<!-- ================================================================== -->

		<page name="buttons">
			<content name="buttonpanel" cardstyle="elevated" title="Buttons &amp; Button Groups" scrollbars="1">

				<paragraph text="Equal Distribution" variant="h2"/>

				<buttongroup distribution="equal">
					<button caption="Start" event="startprocess"/>
					<button caption="Stop" event="stopprocess"/>
					<button caption="Pause" event="pauseprocess"/>
					<button caption="Resume" event="resumeprocess"/>
				</buttongroup>

				<separator name="sep_btn_1" orientation="horizontal" variant="light"/>

				<paragraph text="Equal Distribution - 2 Buttons" variant="h2"/>

				<buttongroup distribution="equal">
					<button caption="Create Alert" event="createtestalert"/>
					<button caption="Generate Logs" event="generatelogmessages"/>
				</buttongroup>

				<separator name="sep_btn_2" orientation="horizontal" variant="light"/>

				<paragraph text="Single Button" variant="h2"/>

				<buttongroup distribution="equal">
					<button caption="Reset All Counters" event="resetcounters"/>
				</buttongroup>

				<separator name="sep_btn_3" orientation="horizontal" variant="dark"/>

				<paragraph text="Disabled Button (sync:disabled)" variant="h2"/>

				<buttongroup distribution="equal">
					<button caption="Only When Running" event="stopprocess" sync:disabled="!main.flags.is_running"/>
					<button caption="Only When Paused" event="resumeprocess" sync:disabled="!main.flags.is_paused"/>
				</buttongroup>

				<separator name="sep_btn_4" orientation="horizontal" variant="light"/>

				<paragraph text="Dialog Trigger" variant="h2"/>

				<buttongroup distribution="equal">
					<button caption="Show Test Dialog" event="showdialog"/>
				</buttongroup>

			</content>
		</page>


		<!-- ================================================================== -->
		<!-- PAGE 5: Data Tables                                                 -->
		<!-- Tests: parameterlist, alertlist                                      -->
		<!-- ================================================================== -->

		<page name="datatables">
			<grid name="datagrid">
				<column width="1" unit="free"/>
				<column width="1" unit="free"/>

				<row height="1" unit="free"/>

				<content name="paramspanel" cardstyle="elevated" title="Parameter List" columnstart="1" rowstart="1" columnend="1" rowend="1" scrollbars="1">

					<paragraph text="Live system parameters from all parameter groups." variant="subtext"/>

					<separator name="sep_data_1" orientation="horizontal" variant="light"/>

					<parameterlist loadingtext="Loading parameters">
						<entry statemachine="main" group="sensors"/>
						<entry statemachine="main" group="counters"/>
						<entry statemachine="main" group="display"/>
						<entry statemachine="main" group="flags"/>
					</parameterlist>

				</content>

				<content name="alertspanel" cardstyle="elevated" title="Alert List" columnstart="2" rowstart="1" columnend="2" rowend="1" scrollbars="1">

					<paragraph text="Active alerts with severity levels and acknowledgement." variant="subtext"/>

					<separator name="sep_data_2" orientation="horizontal" variant="light"/>

					<alertlist name="alerts" loadingtext="Loading alerts" entriesperpage="20"/>

					<separator name="sep_data_3" orientation="horizontal" variant="light"/>

					<paragraph text="Test Actions" variant="label"/>

					<buttongroup distribution="equal">
						<button caption="Info Alert" event="createtestalert"/>
						<button caption="Warning Alert" event="createtestalert"/>
						<button caption="Error Alert" event="createtestalert"/>
						<button caption="Critical Alert" event="createtestalert"/>
					</buttongroup>

				</content>
			</grid>
		</page>


		<!-- ================================================================== -->
		<!-- PAGE 6: Build Workflow                                               -->
		<!-- Tests: upload, buildlist, executionlist, tabs                        -->
		<!-- ================================================================== -->

		<page name="buildworkflow">
			<tabs name="buildtabs">
				<content name="uploadtab" caption="Upload">

					<paragraph text="Upload Test" variant="h2"/>
					<paragraph text="Upload a 3MF file to test the upload widget with progress indication and drag-and-drop." variant="subtext"/>

					<separator name="sep_bw_1" orientation="horizontal" variant="light"/>

					<upload class="build" caption="Select 3MF files to upload" successevent="onuploadfinished"/>

				</content>

				<content name="buildstab" caption="Build Library">

					<paragraph text="Build Library" variant="h2"/>
					<paragraph text="Browse uploaded builds with thumbnails, metadata, and action buttons." variant="subtext"/>

					<separator name="sep_bw_2" orientation="horizontal" variant="light"/>

					<buildlist loadingtext="Loading builds" entriesperpage="20" selectevent="onselectbuild">
						<button name="selectbuild" caption="Select" event="onselectbuild"/>
					</buildlist>

				</content>

				<content name="exectab" caption="Execution History">

					<paragraph text="Execution History" variant="h2"/>
					<paragraph text="Past build executions with status badges, timestamps, and duration." variant="subtext"/>

					<separator name="sep_bw_3" orientation="horizontal" variant="light"/>

					<executionlist loadingtext="Loading executions" entriesperpage="20">
						<button name="details" caption="Details" event=""/>
					</executionlist>

				</content>
			</tabs>
		</page>


		<!-- ================================================================== -->
		<!-- PAGE 7: Visualization (Charts)                                      -->
		<!-- Tests: chart                                                         -->
		<!-- ================================================================== -->

		<page name="visualization">
			<grid name="vizgrid">
				<column width="1" unit="free"/>

				<row height="1" unit="free"/>
				<row height="80" unit="pt"/>

				<content name="chartpanel" cardstyle="elevated" title="Chart Widget" columnstart="1" rowstart="1" columnend="1" rowend="1">

					<paragraph text="Real-time data visualization chart." variant="subtext"/>

					<separator name="sep_viz_1" orientation="horizontal" variant="light"/>

					<chart name="testchart">
					</chart>

				</content>

				<content name="chartactions" columnstart="1" rowstart="2" columnend="1" rowend="2" rowposition="centered">
					<buttongroup distribution="equal">
						<button caption="Update Chart Data" event="updatechartdata"/>
						<button caption="Generate Sine Wave" event="updatechartdata"/>
					</buttongroup>
				</content>
			</grid>
		</page>


		<!-- ================================================================== -->
		<!-- PAGE 8: System Logs                                                  -->
		<!-- Tests: logs                                                           -->
		<!-- ================================================================== -->

		<page name="systemlogs">
			<grid name="loggrid">
				<column width="1" unit="free"/>

				<row height="1" unit="free"/>
				<row height="80" unit="pt"/>

				<content name="logpanel" cardstyle="elevated" title="System Log Messages" columnstart="1" rowstart="1" columnend="1" rowend="1">

					<logs name="systemlog" caption="Log Messages">
					</logs>

				</content>

				<content name="logactions" columnstart="1" rowstart="2" columnend="1" rowend="2" rowposition="centered">
					<buttongroup distribution="equal">
						<button caption="Generate 10 Log Messages" event="generatelogmessages"/>
						<button caption="Start Process (generates logs)" event="startprocess"/>
					</buttongroup>
				</content>
			</grid>
		</page>


		<!-- ================================================================== -->
		<!-- PAGE 9: 3D Scene                                                     -->
		<!-- Tests: glscene                                                       -->
		<!-- ================================================================== -->

		<page name="scene3d">
			<glscene name="glscene_test">
				<models>
				</models>

				<lights>
					<spotlight name="spotlight">
					</spotlight>
				</lights>

				<fog>
				</fog>

				<scene>
				</scene>
			</glscene>
		</page>


		<!-- ================================================================== -->
		<!-- PAGE 10: Stress &amp; Edge Cases                                    -->
		<!-- Tests: deeply nested grids, many widgets, scrollbars, empty states   -->
		<!-- ================================================================== -->

		<page name="stress">
			<grid name="stressgrid">
				<column width="1" unit="free"/>
				<column width="1" unit="free"/>
				<column width="1" unit="free"/>

				<row height="1" unit="free"/>
				<row height="1" unit="free"/>

				<content name="stress_params" cardstyle="elevated" title="Parameters (Full List)" columnstart="1" rowstart="1" columnend="1" rowend="1" scrollbars="1">
					<parameterlist loadingtext="Loading parameters">
						<entry statemachine="main" group="sensors"/>
						<entry statemachine="main" group="counters"/>
						<entry statemachine="main" group="display"/>
						<entry statemachine="main" group="flags"/>
					</parameterlist>
				</content>

				<content name="stress_alerts" cardstyle="elevated" title="Alerts" columnstart="2" rowstart="1" columnend="2" rowend="1" scrollbars="1">
					<alertlist name="stress_alertlist" loadingtext="Loading alerts" entriesperpage="50"/>
				</content>

				<content name="stress_logs" cardstyle="elevated" title="Logs (High Volume)" columnstart="3" rowstart="1" columnend="3" rowend="1" scrollbars="1">
					<logs name="stress_loglist" caption="Log Messages">
					</logs>
				</content>

				<content name="stress_form" cardstyle="elevated" title="Large Form" columnstart="1" rowstart="2" columnend="2" rowend="2" scrollbars="1">
					<form name="stressform">
						<edit name="sf1" caption="Field 1" value="Value 1"/>
						<edit name="sf2" caption="Field 2" value="Value 2"/>
						<edit name="sf3" caption="Field 3" value="Value 3"/>
						<edit name="sf4" caption="Field 4" value="Value 4"/>
						<edit name="sf5" caption="Field 5" value="Value 5"/>
						<switch name="sf_sw1" caption="Toggle A" value="1"/>
						<switch name="sf_sw2" caption="Toggle B" value="0"/>
						<switch name="sf_sw3" caption="Toggle C" value="1"/>
						<edit name="sf6" caption="Field 6 (synced)" sync:value="main.sensors.temperature" readonly="1"/>
						<edit name="sf7" caption="Field 7 (synced)" sync:value="main.sensors.pressure" readonly="1"/>
						<edit name="sf8" caption="Field 8 (synced)" sync:value="main.sensors.humidity" readonly="1"/>
						<edit name="sf9" caption="Field 9 (synced)" sync:value="main.sensors.laser_power" readonly="1"/>
						<edit name="sf10" caption="Field 10 (synced)" sync:value="main.sensors.gas_flow" readonly="1"/>
					</form>
				</content>

				<content name="stress_buttons" cardstyle="elevated" title="Button Stress" columnstart="3" rowstart="2" columnend="3" rowend="2" scrollbars="1">
					<paragraph text="Many buttons at once" variant="h2"/>

					<buttongroup distribution="equal">
						<button caption="Alert" event="createtestalert"/>
						<button caption="Logs" event="generatelogmessages"/>
					</buttongroup>
					<buttongroup distribution="equal">
						<button caption="Chart" event="updatechartdata"/>
						<button caption="Dialog" event="showdialog"/>
					</buttongroup>
					<buttongroup distribution="equal">
						<button caption="Start" event="startprocess"/>
						<button caption="Stop" event="stopprocess"/>
					</buttongroup>
					<buttongroup distribution="equal">
						<button caption="Pause" event="pauseprocess"/>
						<button caption="Resume" event="resumeprocess"/>
					</buttongroup>
					<buttongroup distribution="equal">
						<button caption="Reset" event="resetcounters"/>
						<button caption="Builds" event="gotobuilds"/>
					</buttongroup>

					<separator name="sep_stress_1" orientation="horizontal" variant="dark"/>

					<paragraph text="All button events should fire and log correctly." variant="subtext"/>
				</content>
			</grid>
		</page>


		<!-- ================================================================== -->
		<!-- PAGE 11: Workflow Editor                                            -->
		<!-- Tests: workflow                                                      -->
		<!-- ================================================================== -->

		<page name="workfloweditor">
			<content name="workflowpanel" cardstyle="elevated" title="Workflow Editor">
				<workflow name="testworkflow" caption="Workflow Editor">
					<step id="exposure"        label="Exposure"         category="functionblock" color="blue"/>
					<step id="delay"           label="Delay"            category="functionblock" color="blue">
						<param name="duration" type="int" unit="ms" default="1000"/>
					</step>
					<step id="beschichter_lr"  label="Beschichter L→R"  category="template" color="amber"/>
					<step id="beschichter_rl"  label="Beschichter R→L"  category="template" color="amber"/>
					<step id="dosierung_r"     label="Dosierung R"      category="template" color="amber"/>
					<step id="dosierung_l"     label="Dosierung L"      category="template" color="amber"/>
					<step id="heatup_layer"    label="Heatup Layer"     category="template" color="amber"/>
					<step id="hold_temp"       label="Hold Temperature" category="template" color="amber"/>
				</workflow>
			</content>
		</page>


		<!-- ================================================================== -->
		<!-- PAGE 12: Formula Demonstrator                                       -->
		<!-- Tests: formulas in sync: attributes, session variables              -->
		<!-- ================================================================== -->

		<!-- Every sync: attribute on this page is a formula that the server evaluates; the client
		     only receives the result. Each example shows the formula as a code paragraph followed by
		     its live result. The inputs are session variables, so every browser session has its own
		     values. Formulas over session variables are shown in paragraphs, because form fields and
		     buttons also evaluate their formulas once without a session.
		     See Documentation/FormulaDocumentationAndTutorial.html. -->
		<page name="formulademo">
			<grid name="formulademogrid" padding="8">
				<column width="1" unit="free"/>
				<column width="1" unit="free"/>
				<column width="1" unit="free"/>

				<row height="1" unit="free"/>

				<content name="fd_inputs" title="Inputs" subtitle="Session variables of this browser session" columnstart="1" rowstart="1" columnend="1" rowend="1" scrollbars="1">
					<paragraph name="fd_inputsintro" text="Every field writes one session variable (session.formula_a, session.formula_b, session.formula_level, session.formula_text, session.formula_flag, session.formula_unit). Change a value and watch the results update. A second browser keeps its own values."/>

					<form name="fd_inputform">
						<number name="fd_a" caption="A" sync:value="session.formula_a" step="0.5" changeevent="onformulademochange"/>
						<number name="fd_b" caption="B" sync:value="session.formula_b" step="0.5" changeevent="onformulademochange"/>
						<slider name="fd_level" caption="Level" sync:value="session.formula_level" min="-20" max="150" step="1" unit="%" changeevent="onformulademochange"/>
						<edit name="fd_text" caption="Text" sync:value="session.formula_text" changeevent="onformulademochange"/>
						<switch name="fd_flag" caption="Flag" sync:value="session.formula_flag" changeevent="onformulademochange"/>
						<combobox name="fd_unit" caption="Unit" valuetype="string" sync:value="session.formula_unit" changeevent="onformulademochange">
							<item text="Millimeter (mm)" value="mm"/>
							<item text="Micrometer (um)" value="um"/>
							<item text="Inch (in)" value="in"/>
						</combobox>
					</form>

					<!-- The button is disabled while all inputs still have their default values. -->
					<buttongroup name="fd_inputbuttons" distribution="equal">
						<button name="fd_reset" caption="Reset Inputs" event="onformulademoreset" sync:disabled="session.formula_a == 12.5 and session.formula_b == 4 and session.formula_level == 75 and session.formula_text == 'WidgetTest' and session.formula_flag and session.formula_unit == 'mm'"/>
					</buttongroup>

					<separator name="fd_sep_style" orientation="horizontal" variant="light"/>

					<paragraph name="fd_styletitle" variant="label" text="Formulas in other attributes"/>
					<paragraph name="fd_stylecode" variant="code" text="sync:variant = if(session.formula_flag, 'h2', 'subtext')"/>
					<paragraph name="fd_styleresult" sync:variant="if(session.formula_flag, 'h2', 'subtext')" sync:text="if(session.formula_flag, 'Flag is on: this paragraph is a heading.', 'Flag is off: this paragraph is small print.')"/>
					<paragraph name="fd_buttoncode" variant="code" text="Reset button: sync:disabled = session.formula_a == 12.5 and session.formula_b == 4 and ... and session.formula_unit == 'mm'"/>
				</content>

				<content name="fd_calc" title="Arithmetic, Logic and Text" subtitle="Formulas over the inputs" columnstart="2" rowstart="1" columnend="2" rowend="1" scrollbars="1">
					<paragraph name="fd_arithtitle" variant="label" text="Arithmetic"/>
					<paragraph name="fd_precedencecode" variant="code" text="session.formula_a + session.formula_b * 2"/>
					<paragraph name="fd_precedenceresult" variant="h2" sync:text="concat('= ', session.formula_a + session.formula_b * 2)"/>
					<paragraph name="fd_parenscode" variant="code" text="(session.formula_a + session.formula_b) * 2"/>
					<paragraph name="fd_parensresult" variant="h2" sync:text="concat('= ', (session.formula_a + session.formula_b) * 2)"/>
					<paragraph name="fd_rawdivcode" variant="code" text="session.formula_a / 3"/>
					<paragraph name="fd_rawdivresult" variant="h2" sync:text="concat('= ', session.formula_a / 3)"/>
					<paragraph name="fd_fixedcode" variant="code" text="fixed(session.formula_a / 3, 2)"/>
					<paragraph name="fd_fixedresult" variant="h2" sync:text="concat('= ', fixed(session.formula_a / 3, 2))"/>
					<paragraph name="fd_minmaxcode" variant="code" text="concat('min ', min(session.formula_a, session.formula_b), ', max ', max(session.formula_a, session.formula_b), ', |A - B| ', abs(session.formula_a - session.formula_b))"/>
					<paragraph name="fd_minmaxresult" variant="h2" sync:text="concat('min ', min(session.formula_a, session.formula_b), ', max ', max(session.formula_a, session.formula_b), ', |A - B| ', abs(session.formula_a - session.formula_b))"/>
					<paragraph name="fd_roundcode" variant="code" text="concat(round(session.formula_a), ' / ', floor(session.formula_a), ' / ', ceil(session.formula_a), ' / ', round(session.formula_a / 3, 1))"/>
					<paragraph name="fd_roundresult" variant="h2" sync:text="concat(round(session.formula_a), ' / ', floor(session.formula_a), ' / ', ceil(session.formula_a), ' / ', round(session.formula_a / 3, 1))"/>

					<separator name="fd_sep_logic" orientation="horizontal" variant="light"/>

					<paragraph name="fd_logictitle" variant="label" text="Comparison and logic"/>
					<paragraph name="fd_comparecode" variant="code" text="if(session.formula_a &gt; session.formula_b, 'A is larger', if(session.formula_a == session.formula_b, 'A equals B', 'B is larger'))"/>
					<paragraph name="fd_compareresult" variant="h2" sync:text="if(session.formula_a &gt; session.formula_b, 'A is larger', if(session.formula_a == session.formula_b, 'A equals B', 'B is larger'))"/>
					<paragraph name="fd_boolcode" variant="code" text="session.formula_flag and session.formula_level &gt;= 50"/>
					<paragraph name="fd_boolresult" variant="h2" sync:text="concat('= ', session.formula_flag and session.formula_level &gt;= 50, '   (a boolean becomes 1 or 0 as text)')"/>
					<paragraph name="fd_betweencode" variant="code" text="if(between(session.formula_level, 0, 100), 'inside 0..100', 'outside 0..100')"/>
					<paragraph name="fd_betweenresult" variant="h2" sync:text="if(between(session.formula_level, 0, 100), 'inside 0..100', 'outside 0..100')"/>
					<paragraph name="fd_clampcode" variant="code" text="concat(clamp(session.formula_level, 0, 100), ' %')"/>
					<paragraph name="fd_clampresult" variant="h2" sync:text="concat(clamp(session.formula_level, 0, 100), ' %')"/>
					<paragraph name="fd_unitcode" variant="code" text="concat(fixed(if(session.formula_unit == 'um', session.formula_a * 1000, if(session.formula_unit == 'in', session.formula_a / 25.4, session.formula_a)), 3), ' ', session.formula_unit)"/>
					<paragraph name="fd_unitresult" variant="h2" sync:text="concat(fixed(if(session.formula_unit == 'um', session.formula_a * 1000, if(session.formula_unit == 'in', session.formula_a / 25.4, session.formula_a)), 3), ' ', session.formula_unit)"/>
					<paragraph name="fd_unithint" variant="subtext" text="A is taken as a length in millimeters and converted into the selected unit."/>

					<separator name="fd_sep_text" orientation="horizontal" variant="light"/>

					<paragraph name="fd_texttitle" variant="label" text="Text"/>
					<paragraph name="fd_upperlencode" variant="code" text="concat(upper(session.formula_text), ' has ', len(session.formula_text), ' characters')"/>
					<paragraph name="fd_upperlenresult" variant="h2" sync:text="concat(upper(session.formula_text), ' has ', len(session.formula_text), ' characters')"/>
					<paragraph name="fd_containscode" variant="code" text="if(contains(lower(session.formula_text), 'widget'), 'contains widget', if(startswith(session.formula_text, 'A'), 'starts with A', 'no match'))"/>
					<paragraph name="fd_containsresult" variant="h2" sync:text="if(contains(lower(session.formula_text), 'widget'), 'contains widget', if(startswith(session.formula_text, 'A'), 'starts with A', 'no match'))"/>
					<paragraph name="fd_coalescecode" variant="code" text="coalesce(session.formula_text, '(no text entered)')"/>
					<paragraph name="fd_coalesceresult" variant="h2" sync:text="coalesce(session.formula_text, '(no text entered)')"/>
					<paragraph name="fd_coalescehint" variant="subtext" text="Clear the text field to see the fallback."/>
				</content>

				<content name="fd_machine" title="Live Machine Values" subtitle="Formulas over state machine parameters" columnstart="3" rowstart="1" columnend="3" rowend="1" scrollbars="1">
					<statusbanner name="fd_banner"
						sync:severity="if(main.counters.error_count &gt; 0, 'error', if(main.flags.is_running, 'info', 'ok'))"
						sync:title="if(main.counters.error_count &gt; 0, concat(main.counters.error_count, ' errors reported'), if(main.flags.is_running, concat('Running: layer ', main.counters.layer_current, ' of ', main.counters.layer_total), 'Process is not running'))"
						sync:description="concat('State: ', main.$state, ', ', main.display.status_message)"/>
					<paragraph name="fd_bannerhint" variant="subtext" text="Severity, title and description of the banner above are three formulas over main.counters.*, main.flags.is_running, main.display.status_message and the current state. Start the process on the Dashboard to see them change."/>

					<separator name="fd_sep_form" orientation="horizontal" variant="light"/>

					<paragraph name="fd_formtitle" variant="label" text="Calculated form fields with format:value"/>
					<form name="fd_machineform">
						<calculated name="fd_progress" caption="Build progress" sync:value="if(main.counters.layer_total &gt; 0, main.counters.layer_current * 100 / main.counters.layer_total, 0)" format:value="%.1f" unit="%"/>
						<calculated name="fd_layers" caption="Layers" sync:value="concat(main.counters.layer_current, ' / ', main.counters.layer_total)"/>
						<calculated name="fd_pressuredelta" caption="Pressure - 1013.25 hPa" sync:value="main.sensors.pressure - 1013.25" format:value="%.2f" unit="hPa"/>
						<calculated name="fd_gasperwatt" caption="Gas flow per laser watt" sync:value="if(main.sensors.laser_power &gt; 0, main.sensors.gas_flow / main.sensors.laser_power, 0)" format:value="%.3f" unit="l/min/W"/>
					</form>
					<paragraph name="fd_progresscode" variant="code" text="Build progress: if(main.counters.layer_total &gt; 0, main.counters.layer_current * 100 / main.counters.layer_total, 0) with format:value=&quot;%.1f&quot;"/>

					<separator name="fd_sep_mixed" orientation="horizontal" variant="light"/>

					<paragraph name="fd_mixedtitle" variant="label" text="Machine values combined with the session"/>
					<paragraph name="fd_mixedcode" variant="code" text="if(main.sensors.temperature &gt;= session.formula_a, 'Temperature is at or above A', concat('Temperature is ', fixed(session.formula_a - main.sensors.temperature, 1), ' C below A'))"/>
					<paragraph name="fd_mixedresult" variant="h2" sync:text="if(main.sensors.temperature &gt;= session.formula_a, 'Temperature is at or above A', concat('Temperature is ', fixed(session.formula_a - main.sensors.temperature, 1), ' C below A'))"/>
					<paragraph name="fd_usercode" variant="code" text="concat('Signed in as ', $user.login, ' (role ', $user.role, '), ', if($user.permission.permission_view_builds, 'may view builds', 'may not view builds'))"/>
					<paragraph name="fd_userresult" variant="h2" sync:text="concat('Signed in as ', $user.login, ' (role ', $user.role, '), ', if($user.permission.permission_view_builds, 'may view builds', 'may not view builds'))"/>

					<separator name="fd_sep_failsoft" orientation="horizontal" variant="light"/>

					<paragraph name="fd_failsofttitle" variant="label" text="Runtime errors fail soft"/>
					<paragraph name="fd_failsoftcode" variant="code" text="session.formula_a / session.formula_b"/>
					<paragraph name="fd_failsoftresult" variant="h2" sync:text="concat('= ', session.formula_a / session.formula_b)"/>
					<paragraph name="fd_failsofthint" variant="subtext" text="Set B to 0: the division fails, the whole formula evaluates to an empty text and the server logs one warning for this formula."/>
					<paragraph name="fd_guardcode" variant="code" text="if(session.formula_b != 0, fixed(session.formula_a / session.formula_b, 3), 'B is zero')"/>
					<paragraph name="fd_guardresult" variant="h2" sync:text="if(session.formula_b != 0, fixed(session.formula_a / session.formula_b, 3), 'B is zero')"/>
					<paragraph name="fd_guardhint" variant="subtext" text="if() only evaluates the selected branch, so a guard avoids the error completely."/>
				</content>
			</grid>
		</page>


